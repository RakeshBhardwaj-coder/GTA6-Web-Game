rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
        'uid',
        'driverName',
        'haul',
        'distanceMeters',
        'copsWrecked',
        'nearMisses',
        'maxCombo',
        'peakStars',
        'carId',
        'mode',
        'seed',
        'titleEarned',
        'isVictory',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'driverName',
        'haul',
        'distanceMeters',
        'copsWrecked',
        'nearMisses',
        'maxCombo',
        'peakStars',
        'carId',
        'mode',
        'seed',
        'titleEarned',
        'isVictory',
        'createdAt'
      ]) &&
      data.uid is string &&
      data.uid.size() >= 1 &&
      data.uid.size() <= 128 &&
      data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      (data.uid == 'public' || (isVerifiedUser() && data.uid == request.auth.uid)) &&
      data.driverName is string &&
      data.driverName.size() >= 2 &&
      data.driverName.size() <= 20 &&
      data.driverName.matches('^[a-zA-Z0-9 _\\-]+$') &&
      data.haul is int &&
      data.haul >= 0 &&
      data.haul <= 10000000 &&
      data.distanceMeters is int &&
      data.distanceMeters >= 0 &&
      data.distanceMeters <= 500000 &&
      data.copsWrecked is int &&
      data.copsWrecked >= 0 &&
      data.copsWrecked <= 5000 &&
      data.nearMisses is int &&
      data.nearMisses >= 0 &&
      data.nearMisses <= 10000 &&
      data.maxCombo is int &&
      data.maxCombo >= 1 &&
      data.maxCombo <= 15 &&
      data.peakStars is int &&
      data.peakStars >= 1 &&
      data.peakStars <= 5 &&
      data.carId is string &&
      data.carId.size() <= 20 &&
      data.carId in ['cheetah', 'banshee', 'comet'] &&
      data.mode is string &&
      data.mode.size() <= 20 &&
      data.mode in ['GETAWAY', 'DAILY', 'ENDLESS'] &&
      data.seed is int &&
      data.seed >= 100000 &&
      data.seed <= 999999 &&
      data.titleEarned is string &&
      data.titleEarned.size() >= 2 &&
      data.titleEarned.size() <= 40 &&
      data.isVictory is bool &&
      data.createdAt == request.time;
    }

    match /leaderboard_entries/{entryId} {
      // Public non-PII arcade leaderboard: anyone can view and query top scores
      allow get: if isValidId(entryId);
      allow list: if true;

      // Public score submission with strict schema, bounds, regex, and server timestamp checks
      allow create: if isValidId(entryId)
        && isValidLeaderboardEntry(incoming());

      // Scores are immutable once recorded
      allow update: if false;

      // Only verified signed-in owners can delete their own non-public entry
      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && existing().uid != 'public'
        && existing().uid == request.auth.uid;
    }
  }
}
